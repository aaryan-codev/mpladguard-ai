# Copy to .env and adjust as needed. Never commit the real .env file.

APP_NAME=MPLADGuard-AI Backend
APP_VERSION=1.0.0
ENVIRONMENT=development

# Comma-separated list, or "*" for all origins (dev only)
CORS_ALLOW_ORIGINS=*

# CSV backing GET /api/projects for the hackathon MVP.
# Current MVP scope is ROAD projects only -- defaults to the road
# dataset if unset (see core/config.py effective_projects_csv_path).
PROJECTS_CSV_PATH=

# Optional, not required to run the ML model locally.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

LOG_LEVEL=INFO
